# Email delivery for the proposal form (app/api/contact/route.ts), via Resend.
# Create a free API key at https://resend.com/api-keys
RESEND_API_KEY=
# Address that receives proposal requests (e.g. the broker's inbox).
CONTACT_TO_EMAIL=contato@volotaoseguros.com.br
# Sender identity Resend sends as. Using their shared sandbox domain works
# out of the box; verify your own domain in Resend to send as @volotaoseguros.com.br.
CONTACT_FROM_EMAIL="Volotão Site <onboarding@resend.dev>"

# Public site details, read by lib/site-config.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000
NEXT_PUBLIC_CONTACT_EMAIL=contato@volotaoseguros.com.br
